import 'package:flutter/material.dart';
import 'monster.dart';
import 'seed.dart';

/// Module 5 - Activity 5 - HAUDEX app (course capstone)

// ADDED: one shared background color used on both screens, so the app has a
// consistent off-white feel instead of the default stark white.
const _kBackground = Color(0xFFF6F6F9);

class DexApp extends StatefulWidget {
  const DexApp({super.key});
  @override
  State<DexApp> createState() => _DexAppState();
}

class _DexAppState extends State<DexApp> {
  final List<Monster> _monsters = List.of(seedMonsters);

  Future<void> _addMonster() async {
    final result = await showDialog<Monster>(
      context: context,
      builder: (context) => const _AddMonsterDialog(),
    );
    if (result == null) return;
    setState(() => _monsters.add(result));
  }

  void _openDetail(int index) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => _MonsterDetailScreen(
          monster: _monsters[index],
          onUpdate: (updated) => setState(() => _monsters[index] = updated),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      // ADDED: soft background instead of default white
      backgroundColor: _kBackground,
      appBar: AppBar(
        // ADDED: bigger, bolder title with letter spacing for a title feel
        title: const Text(
          'HAUDEX',
          style: TextStyle(
            fontSize: 22,
            fontWeight: FontWeight.w800,
            letterSpacing: 0.5,
          ),
        ),
        backgroundColor: _kBackground,
        elevation: 0,
        foregroundColor: Colors.black87,
      ),
      body: ListView.separated(
        padding: const EdgeInsets.symmetric(vertical: 8),
        itemCount: _monsters.length,
        separatorBuilder: (_, __) => const Divider(height: 1),
        itemBuilder: (context, index) {
          final monster = _monsters[index];
          final fainted = monster.hp <= 0;
          return Container(
            // ADDED: white card background behind each row so rows stand
            // out against the new grey page background
            color: Colors.white,
            decoration: BoxDecoration(
              border: Border(
                left: BorderSide(color: _typeColor(monster.type), width: 4),
              ),
            ),
            child: ListTile(
              leading: CircleAvatar(
                backgroundColor: _typeColor(monster.type).withOpacity(0.15),
                child: Text(
                  monster.name.isNotEmpty
                      ? monster.name[0].toUpperCase()
                      : '?',
                  style: TextStyle(
                    color: _typeColor(monster.type),
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
              title: Text(
                monster.name,
                // ADDED: bolder, slightly larger name for a clearer heading
                style: const TextStyle(
                  fontWeight: FontWeight.w700,
                  fontSize: 16,
                ),
              ),
              subtitle: Text(
                '${monster.type} · HP ${monster.hp}/${monster.maxHp}'
                '${fainted ? ' · Fainted' : ''}',
                // ADDED: softer grey subtitle so it reads as secondary text
                style: TextStyle(color: Colors.grey.shade600),
              ),
              trailing: const Icon(Icons.chevron_right),
              onTap: () => _openDetail(index),
            ),
          );
        },
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: _addMonster,
        child: const Icon(Icons.add),
      ),
    );
  }
}

Color _typeColor(String type) {
  switch (type) {
    case 'fire':
      return Colors.red;
    case 'water':
      return Colors.blue;
    case 'grass':
      return Colors.green;
    default:
      return Colors.blueGrey;
  }
}

class _AddMonsterDialog extends StatefulWidget {
  const _AddMonsterDialog();

  @override
  State<_AddMonsterDialog> createState() => _AddMonsterDialogState();
}

class _AddMonsterDialogState extends State<_AddMonsterDialog> {
  final _nameController = TextEditingController();
  String _type = 'fire';

  @override
  void dispose() {
    _nameController.dispose();
    super.dispose();
  }

  void _submit() {
    final name = _nameController.text.trim();
    if (name.isEmpty) return;
    Navigator.of(context).pop(
      Monster(name: name, type: _type, hp: 30, maxHp: 30),
    );
  }

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      // ADDED: rounded dialog shape instead of the default sharp corners
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(16),
      ),
      title: const Text(
        'New Monster',
        style: TextStyle(fontWeight: FontWeight.w700),
      ),
      content: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          TextField(
            controller: _nameController,
            autofocus: true,
            decoration: InputDecoration(
              labelText: 'Name',
              // ADDED: rounded outlined field to match the rest of the app
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(10),
              ),
            ),
            onSubmitted: (_) => _submit(),
          ),
          const SizedBox(height: 12),
          DropdownButtonFormField<String>(
            initialValue: _type,
            decoration: InputDecoration(
              labelText: 'Type',
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(10),
              ),
            ),
            items: const [
              DropdownMenuItem(value: 'fire', child: Text('Fire')),
              DropdownMenuItem(value: 'water', child: Text('Water')),
              DropdownMenuItem(value: 'grass', child: Text('Grass')),
            ],
            onChanged: (value) => setState(() => _type = value ?? _type),
          ),
        ],
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.of(context).pop(),
          child: const Text('Cancel'),
        ),
        FilledButton(onPressed: _submit, child: const Text('Add')),
      ],
    );
  }
}

class _MonsterDetailScreen extends StatefulWidget {
  const _MonsterDetailScreen({required this.monster, required this.onUpdate});

  final Monster monster;
  final ValueChanged<Monster> onUpdate;

  @override
  State<_MonsterDetailScreen> createState() => _MonsterDetailScreenState();
}

class _MonsterDetailScreenState extends State<_MonsterDetailScreen> {
  late Monster _monster = widget.monster;
  String? _feedback;

  void _attack() {
    if (_monster.hp <= 0) return;
    // CHANGED: 15 damage per attack to match the M5A1 contract
    const damage = 15;
    final newHp = (_monster.hp - damage).clamp(0, _monster.maxHp);
    setState(() {
      _monster = Monster(
        name: _monster.name,
        type: _monster.type,
        hp: newHp,
        maxHp: _monster.maxHp,
      );
      _feedback = newHp == 0
          ? '${_monster.name} fainted!'
          : '${_monster.name} took $damage damage!';
    });
    widget.onUpdate(_monster);
  }

  @override
  Widget build(BuildContext context) {
    final fainted = _monster.hp <= 0;
    final fraction = _monster.maxHp == 0 ? 0.0 : _monster.hp / _monster.maxHp;
    final accent = _typeColor(_monster.type);

    return Scaffold(
      // ADDED: same shared background color as the list screen
      backgroundColor: _kBackground,
      appBar: AppBar(
        title: Text(
          _monster.name,
          // ADDED: bolder app bar title to match the list screen
          style: const TextStyle(fontWeight: FontWeight.w800),
        ),
        backgroundColor: accent.withOpacity(0.15),
        foregroundColor: Colors.black87,
        elevation: 0,
      ),
      body: Padding(
        padding: const EdgeInsets.all(24),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              _monster.type,
              key: const Key('detailType'),
              // ADDED: uppercase type label with letter spacing, a common
              // "tag" typography treatment
              style: TextStyle(
                color: accent,
                fontWeight: FontWeight.w700,
                fontSize: 14,
                letterSpacing: 1.2,
              ),
            ),
            const SizedBox(height: 16),
            // ADDED: HP block wrapped in a white card so it stands out
            // against the grey page background, with clearer size hierarchy
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(14),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    crossAxisAlignment: CrossAxisAlignment.baseline,
                    textBaseline: TextBaseline.alphabetic,
                    children: [
                      const Text(
                        'HP',
                        style: TextStyle(
                          fontWeight: FontWeight.w700,
                          fontSize: 12,
                          letterSpacing: 1,
                        ),
                      ),
                      const SizedBox(width: 8),
                      Text(
                        '${_monster.hp}',
                        key: const Key('hp'),
                        // ADDED: much larger HP number for a clear focal
                        // point, instead of the same size as the label text
                        style: const TextStyle(
                          fontWeight: FontWeight.w800,
                          fontSize: 28,
                        ),
                      ),
                      Text(
                        ' / ${_monster.maxHp}',
                        style: TextStyle(color: Colors.grey.shade600),
                      ),
                    ],
                  ),
                  const SizedBox(height: 10),
                  ClipRRect(
                    borderRadius: BorderRadius.circular(8),
                    child: LinearProgressIndicator(
                      value: fraction,
                      minHeight: 10,
                      backgroundColor: Colors.grey.shade200,
                      valueColor: AlwaysStoppedAnimation(
                        fraction <= 0.2 ? Colors.red : Colors.green,
                      ),
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 16),
            if (_feedback != null)
              Text(
                _feedback!,
                style: TextStyle(
                  color: fainted ? Colors.grey : Colors.red,
                  fontWeight: FontWeight.w600,
                ),
              ),
            const Spacer(),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: fainted ? null : _attack,
                style: ElevatedButton.styleFrom(
                  backgroundColor: fainted ? null : accent,
                  foregroundColor: Colors.white,
                  padding: const EdgeInsets.symmetric(vertical: 14),
                  // ADDED: rounded button shape to match the rest of the app
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(10),
                  ),
                  // ADDED: bolder, slightly larger label text
                  textStyle: const TextStyle(
                    fontWeight: FontWeight.w700,
                    fontSize: 16,
                  ),
                ),
                child: const Text('Attack'),
              ),
            ),
          ],
        ),
      ),
    );
